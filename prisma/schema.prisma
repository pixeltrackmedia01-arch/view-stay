generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  ADMIN
}

enum HotelStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ViewType {
  SEA
  MOUNTAIN
  CITY
  GARDEN
  POOL
  COURTYARD
  NONE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum MapElementKind {
  ELEVATOR
  STAIRS
  CORRIDOR
  LOBBY
  SERVICE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hotels       Hotel[]
  bookings     Booking[]
  holds        RoomHold[]
  wishlist     Wishlist[]
  reviews      Review[]
  auditLogs    AuditLog[]
}

model Hotel {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  description  String
  city         String
  country      String
  address      String
  starRating   Int         @default(3)
  amenities    String[]
  coverHue     Int         @default(200)
  checkInTime  String      @default("14:00")
  checkOutTime String      @default("11:00")
  status       HotelStatus @default(PENDING)
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  floors       Floor[]
  roomTypes    RoomType[]
  rooms        Room[]
  bookings     Booking[]
  wishlist     Wishlist[]
  reviews      Review[]

  @@index([city])
  @@index([status])
}

model Floor {
  id       String       @id @default(cuid())
  hotelId  String
  hotel    Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  level    Int
  name     String
  // Map grid size in abstract units
  width    Int          @default(12)
  height   Int          @default(6)
  rooms    Room[]
  elements MapElement[]

  @@unique([hotelId, level])
}

model MapElement {
  id      String         @id @default(cuid())
  floorId String
  floor   Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  kind    MapElementKind
  label   String
  x       Int
  y       Int
  w       Int
  h       Int
}

model RoomType {
  id          String  @id @default(cuid())
  hotelId     String
  hotel       Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String
  bedType     String
  maxGuests   Int
  sizeSqm     Int
  // Base nightly price in minor currency units (paise / cents)
  basePrice   Int
  rooms       Room[]

  @@unique([hotelId, name])
}

model Room {
  id               String         @id @default(cuid())
  hotelId          String
  hotel            Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  floorId          String
  floor            Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomTypeId       String
  roomType         RoomType       @relation(fields: [roomTypeId], references: [id])
  number           String
  viewType         ViewType       @default(NONE)
  // 0-100, verified by the property team
  viewScore        Int            @default(50)
  viewVerified     Boolean        @default(false)
  hasBalcony       Boolean        @default(false)
  isCorner         Boolean        @default(false)
  windowCount      Int            @default(1)
  nearElevator     Boolean        @default(false)
  accessible       Boolean        @default(false)
  // Premium (positive) or discount (negative) on top of room type base price, minor units
  priceAdjustment  Int            @default(0)
  notes            String?
  status           RoomStatus     @default(ACTIVE)
  // Position on the floor map grid
  x                Int
  y                Int
  w                Int            @default(2)
  h                Int            @default(2)
  bookings         Booking[]
  holds            RoomHold[]
  blocks           RoomBlock[]

  @@unique([hotelId, number])
  @@index([floorId])
}

model RoomHold {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  guests    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([roomId, expiresAt])
  @@index([userId])
}

model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())

  @@index([roomId])
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  hotelId        String
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id])
  checkIn        DateTime      @db.Date
  checkOut       DateTime      @db.Date
  nights         Int
  guests         Int
  guestName      String
  guestEmail     String
  guestPhone     String
  specialRequest String?
  nightlyRate    Int
  subtotal       Int
  taxes          Int
  total          Int
  currency       String        @default("INR")
  status         BookingStatus @default(CONFIRMED)
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       Payment[]
  review         Review?

  @@index([roomId, checkIn, checkOut])
  @@index([userId])
  @@index([hotelId])
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String?
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  provider  String        @default("dummy")
  reference String        @unique
  amount    Int
  cardLast4 String
  status    PaymentStatus
  message   String?
  createdAt DateTime      @default(now())
}

model Wishlist {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hotelId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
